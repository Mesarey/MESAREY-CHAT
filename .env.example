# Copia este archivo a .env y complétalo. polybot.py solo lee credenciales
# del entorno; nunca las imprime ni las escribe a disco.
#
#   cp .env.example .env
#   set -a && source .env && set +a && python polybot.py probe

POLYMARKET_PRIVATE_KEY=0x...
POLYMARKET_FUNDER=0x...
POLYMARKET_SIGNATURE_TYPE=1

# Opcionales, solo si ya derivaste credenciales L2 del CLOB:
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
