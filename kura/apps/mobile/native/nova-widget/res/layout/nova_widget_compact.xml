<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nova_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nova_widget_bg_noche"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/nova_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nova_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="@string/nova_widget_sample_label"
            android:textColor="@color/nova_accent"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nova_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/nova_widget_pill"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="30dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/nova_widget_next"
            android:textColor="@color/nova_text"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/nova_frase"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="17sp"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:paddingEnd="6dp"
        android:text="@string/nova_widget_sample"
        android:textColor="@color/nova_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/nova_contexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingEnd="6dp"
        android:text="@string/nova_widget_sample_ctx"
        android:textColor="@color/nova_muted"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
