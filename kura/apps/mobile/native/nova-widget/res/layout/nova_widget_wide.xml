<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nova_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nova_widget_bg_noche"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/nova_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/nova_mark"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/nova_widget_ic_nova" />

        <TextView
            android:id="@+id/nova_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="@string/nova_widget_sample_label"
            android:textColor="@color/nova_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/nova_config"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:contentDescription="@string/nova_widget_config"
            android:padding="6dp"
            android:src="@drawable/nova_widget_ic_gear" />
    </LinearLayout>

    <TextView
        android:id="@+id/nova_frase"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="20sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:paddingEnd="8dp"
        android:text="@string/nova_widget_sample"
        android:textColor="@color/nova_text"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/nova_contexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:paddingEnd="8dp"
        android:text="@string/nova_widget_sample_ctx"
        android:textColor="@color/nova_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nova_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/nova_widget_pill"
            android:gravity="center"
            android:minWidth="56dp"
            android:minHeight="36dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/nova_widget_next"
            android:textColor="@color/nova_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/nova_mode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/nova_widget_pill"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="36dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/nova_widget_mode_regla"
            android:textColor="@color/nova_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/nova_practice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/nova_widget_pill_solid"
            android:gravity="center"
            android:minHeight="36dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/nova_widget_practice"
            android:textColor="@color/nova_ink"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
